  m_TableData:
  - m_Id: 1152381407834112
    m_Localized: "\uB0B4 \uC704\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 1152458650136576
    m_Localized: "\uCD9C\uBC1C\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1153150399918080
    m_Localized: "\uB3C4\uCC29\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 2238818991583232
    m_Localized: "\uAC80\uC0C9 \uC7A5\uC18C\uB97C \uC785\uB825\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 2600483117445120
    m_Localized: "\uC548\uB155\uD558\uC138\uC694. \uC218\uBAA9\uC6D0\uC5D0 \uBC29\uBB38\uD574
      \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC800\uB294 \uACE0\uAC1D\uB2D8\uAED8
      \uB2E4\uC591\uD55C \uB3C4\uC6C0\uC744 \uB4DC\uB9B4 \uC218\uBAA9\uC6D0\uCC57\uBD07\uC774\uB77C\uACE0
      \uD569\uB2C8\uB2E4. \r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2600674751000576
    m_Localized: "\uD3B8\uC548\uD55C \uC548\uB0B4\uB97C \uC704\uD574 \uC81C\uAC00
      \uACE0\uAC1D\uB2D8\uC744 \uC5B4\uB5BB\uAC8C \uBD80\uB974\uBA74 \uB420\uAE4C\uC694?\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4046096765923328
    m_Localized: "\uC11C\uBE44\uC2A4 \uC774\uC6A9\uC57D\uAD00 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 4046155502956544
    m_Localized: "\uAC1C\uC778\uC815\uBCF4 \uC774\uC6A9\uC57D\uAD00 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 4046207759790080
    m_Localized: "\uB9C8\uCF00\uD305 \uC815\uBCF4 \uC218\uC2E0\uC5D0 \uB3D9\uC758"
    m_Metadata:
      m_Items: []
  - m_Id: 9010204967809024
    m_Localized: "\uD034\uC988\uD480\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 9010238748733440
    m_Localized: "\uAE38 \uCC3E\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 9010372651888640
    m_Localized: "\uAC10\uAC01\uC815\uC6D0\uC740 \uB204\uAD6C\uB098 \uC7A5\uBCBD\uC5C6\uC774
      \uB204\uB9AC\uB294 \uBCA0\uB9AC\uC5B4\uD504\uB9AC \uC815\uC6D0\uC744 \uB9CC\uB4E4\uC5B4
      \uAC11\uB2C8\uB2E4. \uC815\uC6D0\uC774 \uAC00\uC9C0\uACE0 \uC788\uB294 \uC0C9,
      \uC18C\uB9AC, \uCD09\uAC10, \uD5A5\uAE30\uB97C \uD1B5\uD574 \uB208\uC73C\uB85C\uB9CC
      \uBCF4\uB294 \uAC83\uC774 \uC544\uB2CC \uC624\uAC10\uC73C\uB85C \uC815\uC6D0\uC744
      \uB4E3\uACE0, \uB9CC\uC9C0\uACE0, \uD5A5\uAE30\uB97C \uB290\uB07C\uBA70 \uB354
      \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9010397415059456
    m_Localized: "\uC0C1\uC9D5\uC131, \uC5ED\uC0AC\uC131 \uB4F1\uC774 \uC788\uB294
      \uB098\uBB34\uC758 \uC720\uC804\uC790\uC6D0\uC744 \uBCF4\uC874\uD558\uB294
      \uACF3\uC73C\uB85C \uC815\uC774\uD488\uC1A1 \uC18C\uB098\uBB34, \uC6A9\uBB38\uC0AC
      \uC740\uD589\uB098\uBB34 \uB4F1\uACFC \uCC9C\uC5F0\uAE30\uB150\uBB3C(\uC2DD\uBB3C)\uB85C
      \uC9C0\uC815\uB41C \uB098\uBB34\uC758 \uC720\uC804\uC790\uC6D0 \uADF8\uB9AC\uACE0
      \uAD6D\uC678\uC2DD\uBB3C \uC911 \uB274\uD134\uC758 \uC0AC\uACFC\uB098\uBB34(4\uB300\uC190),
      \uBA58\uB378\uC758 \uD3EC\uB3C4\uB098\uBB34 \uB4F1\uB3C4 \uC2DD\uC7AC\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9010623928446976
    m_Localized: "\uBA39\uAC70\uB9AC\uB098 \uBCFC\uAC70\uB9AC\uB85C \uD65C\uC6A9\uB418\uB294
      \uC2DD\uBB3C\uC744 \uD0A4\uC6B0\uACE0 \uC218\uD655\uD558\uB294 \uACFC\uC815\uC744
      \uC9C1\uC811 \uCC38\uC5EC\uD558\uACE0 \uCCB4\uD5D8\uD560 \uC218 \uC788\uB294
      \uC815\uC6D0\uC785\uB2C8\uB2E4. \uC0DD\uD65C\uC815\uC6D0\uC740 \uCC44\uC18C
      \uC528\uC557\uC744 \uBFCC\uB824\uC11C \uC5B4\uB9B0 \uC2DD\uBB3C\uC744 \uC0DD\uC0B0\uD558\uB294
      \uC628\uC2E4, \uC0AC\uACFC\uB098\uBB34 \uBCBD\uBA74\uC7A5\uC2DD\uC815\uC6D0,
      \uBE14\uB8E8\uBCA0\uB9AC \uC815\uC6D0, \uC720\uC2E4\uC218 \uC815\uC6D0, \uC0B0\uB098\uBB3C\uC815\uC6D0
      \uB4F1 \uB2E4\uC591\uD55C \uD615\uD0DC\uC758 \uC815\uC6D0\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9010671835787264
    m_Localized: "\uC815\uC6D0\uC2DD\uBB3C\uAC00\uB2A0\uD130\uB294 \uC0C8\uB85C\uC6B4
      \uC815\uC6D0\uC2DD\uBB3C\uC744 \uBC1C\uAD74\uD558\uAE30 \uC704\uD558\uC5EC
      \uB2E4\uC591\uD55C \uC2DD\uBB3C\uC744 \uC2DC\uD5D8\uD558\uACE0 \uD3C9\uAC00\uD558\uB294
      \uC815\uC6D0\uC785\uB2C8\uB2E4. \uAC01 \uC2DD\uBB3C\uC758 \uC0DD\uC7A5\uD2B9\uC9D5\uC774
      \uC815\uC6D0\uC774\uB77C\uB294 \uD658\uACBD\uC870\uAC74\uC5D0\uC11C \uC5B4\uB5BB\uAC8C
      \uBC1C\uD604\uB418\uB294\uC9C0, \uB3D9\uC77C\uD55C \uC885\uC5D0\uC11C \uD30C\uC0DD\uB41C
      \uC5EC\uB7EC \uD488\uC885\uC774 \uC5B4\uB5A4 \uCC28\uC774\uB97C \uBCF4\uC774\uB294
      \uC9C0 \uC9C1\uC811 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD2B9\uD788
      \uB3C4\uC2EC \uD55C\uAC00\uC6B4\uB370\uC11C \uC704\uCE58\uD55C \uC9C0\uB9AC\uC801
      \uC774\uC810\uC744 \uD65C\uC6A9\uD558\uC5EC \uC2DD\uBB3C\uC758 \uB3C4\uC2DC\uD658\uACBD\uC801\uC751\uC131\uC744
      \uD3C9\uAC00\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9010711568429056
    m_Localized: "\uC218\uBAA9\uC6D0\uB0B4\uC5D0 \uC870\uC131\uB41C \uC778\uACF5\uC218\uB85C\uC785\uB2C8\uB2E4.
      \uBB3C\uAC00\uB098 \uBB3C\uC18D\uC5D0 \uC790\uC0DD\uD558\uB294 \uB2E4\uC591\uD55C
      \uC218\uC0DD \uBC0F \uC218\uBCC0\uC2DD\uBB3C\uACFC \uD568\uAED8 \uACC4\uC808\uBCC4\uB85C
      \uCC3E\uC544\uB4DC\uB294 \uCCA0\uC0C8\uC640 \uBB3C\uC0C8\uB3C4 \uAD00\uCC30\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCCAD\uB958\uC9C0\uC6D0\uC740 \uC5F0\uAD6C\uB3D9
      \uC55E \uD568\uC591\uC9C0\uC5D0\uC11C \uCD9C\uBC1C\uD55C \uBB3C\uAE38\uC774
      \uC804\uD1B5\uC815\uC6D0\uC744 \uB3CC\uC544 \uBBFC\uC18D\uC2DD\uBB3C\uC6D0\uAE4C\uC9C0
      \uC57D 2.4km\uB85C \uC774\uC5B4\uC838 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9014347354714112
    m_Localized: "\uD55C\uAD6D\uC804\uD1B5\uC815\uC6D0\uC740 \uAD81\uAD90\uC815\uC6D0,
      \uBCC4\uC11C\uC815\uC6D0, \uBBFC\uAC00\uC815\uC6D0\uC774 \uC788\uC2B5\uB2C8\uB2E4.
      \uAD81\uAD90\uC815\uC6D0\uC740 \uCC3D\uB355\uAD81 \uC8FC\uD569\uB8E8\uC640
      \uBD80\uC6A9\uC815\uC744 \uC2E4\uC81C\uD06C\uAE30\uB85C \uC870\uC131\uD558\uC600\uACE0,
      \uBCC4\uC11C\uC815\uC6D0\uC740 \uC18C\uC1C4\uC6D0\uC744 \uC8FC\uC81C\uB85C
      \uACC4\uB958, \uD654\uC624, \uB2F4\uC7A5 \uB4F1\uC744 \uC5F0\uCD9C\uD558\uC600\uC2B5\uB2C8\uB2E4.
      \uBBFC\uAC00\uC815\uC6D0\uC740 \uC61B \uB9C8\uC744\uC5D0\uC11C \uBCFC \uC218
      \uC788\uB294 \uC815\uC790\uBAA9\uACFC \uB3CC\uB2F4 \uB4F1\uC744 \uC815\uC6D0\uC694\uC18C\uB85C
      \uB3C4\uC785\uD574 \uCE5C\uC219\uD558\uBA74\uC11C\uB3C4 \uD3B8\uC548\uD568\uC744
      \uC8FC\uB3C4\uB85D \uC870\uC131\uD558\uC600\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9014389759127552
    m_Localized: "\uD654\uBD84\uC5D0 \uB2F4\uAE34 \uC790\uC5F0\uC758 \uCD95\uC18C\uD310\uC774\uB77C
      \uBD88\uB9AC\uB294 \uBD84\uC7AC\uB97C \uAC10\uC0C1\uD558\uB294 \uACF5\uAC04\uC785\uB2C8\uB2E4.
      \uB2E4\uC591\uD55C \uD615\uD0DC\uC758 \uBD84\uC7AC\uC791\uD488 200\uC5EC\uC810\uC774
      \uC804\uC2DC\uB418\uC5B4 \uC788\uC73C\uBA70 4\uACC4\uC808\uB3D9\uC548 \uBD84\uC7AC
      \uAD00\uB78C\uC774 \uAC00\uB2A5\uD55C \uBD84\uC7AC\uC804\uC2DC\uAD00, \uBD84\uC7AC\uAD50\uC721\uD504\uB85C\uADF8\uB7A8\uC774
      \uC6B4\uC601\uB418\uB294 \uBD84\uC7AC\uBB38\uD654\uAD00, \uC9C4\uACBD\uC0B0\uC218\uB97C
      \uCD95\uC18C\uD55C \uC11D\uAC00\uC0B0\uC73C\uB85C \uAD6C\uC131\uB418\uC5B4
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9014419727429632
    m_Localized: "\uD76C\uADC0\xB7\uD2B9\uC0B0\uC2DD\uBB3C\uC804\uC2DC\uC6D0\uC740
      \uC138\uACC4\uC801\uC73C\uB85C \uC6B0\uB9AC\uB098\uB77C\uC5D0\uC11C\uB9CC \uBCFC
      \uC218 \uC788\uB294 \uD2B9\uC0B0\uC2DD\uBB3C(endemic plants)\uACFC \uC11C\uC2DD\uC9C0\uC5D0\uC11C
      \uC0AC\uB77C\uC838\uAC00\uB294 \uD76C\uADC0\uC2DD\uBB3C(rare plants)\uC744
      \uC218\uC9D1\xB7\uBCF4\uC804\xB7\uC804\uC2DC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uC804\uC2DC\uC628\uC2E4 2\uAC1C\uB3D9(1,276.68\u33A1)\uACFC \uC57C\uC678\uC804\uC2DC\uC6D0(14,400\u33A1)\uC5D0\uC11C
      \uC81C\uC8FC\uB3C4, \uB09C\uB300 \uC2DD\uBB3C\uBD80\uD130 \uBC31\uB450\uB300\uAC04
      \uC544\uACE0\uC0B0 \uC2DD\uBB3C\uAE4C\uC9C0 550\uC5EC \uC885\uC758 \uC790\uC0DD\uC2DD\uBB3C\uACFC
      230\uC5EC \uC885\uC758 \uD76C\uADC0\xB7\uD2B9\uC0B0\uC2DD\uBB3C\uC744 \uB9CC\uB098\uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9014458042396672
    m_Localized: "\uD0C4\uC18C\uC800\uAC10 \uBAA8\uB378\uC815\uC6D0\uC740 \uD0C4\uC18C\uC911\uB9BD
      \uAE30\uB2A5\uC744 \uADF9\uB300\uD654\uD560 \uC218 \uC788\uB294 \uC815\uC6D0\uBAA8\uB378\uC744
      \uAC1C\uBC1C\uD558\uACE0 \uD0C4\uC18C\uD761\uC218 \uAE30\uC220 \uC2E4\uC99D\uD654\uB97C
      \uC704\uD574 \uC720\uD615\uBCC4 \uC2DC\uD5D8\uAD6C\uB97C \uC870\uC131\uD558\uC5EC
      \uBAA8\uB2C8\uD130\uB9C1\uD558\uB294 \uC804\uC2DC\uC6D0\uC73C\uB85C \uC815\uC6D0\uC758
      \uD0C4\uC18C\uD761\uC218 \uAE30\uB2A5 \uAC15\uD654 \uBC0F \uD655\uC0B0\uC5D0
      \uAE30\uC5EC\uD558\uAE30 \uC704\uD55C \uC804\uBB38 \uC804\uC2DC\uC6D0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9014532529041408
    m_Localized: "\uC232\uC758 \uCE35\uC0C1\uAD6C\uC870\uB97C \uACE0\uB824\uD558\uC5EC
      \uC2DD\uC7AC\uD558\uC600\uC73C\uBA70, \uC9C0\uC18D \uAC00\uB2A5\uD55C \uC815\uC6D0\uC73C\uB85C
      \uC790\uC5F0\uACBD\uAD00\uBFD0\uB9CC \uC544\uB2C8\uB77C \uC0DD\uBB3C\uC11C\uC2DD\uCC98\uB85C\uC11C
      \uC5ED\uD560\uC744 \uD558\uACE0\uC790 \uD569\uB2C8\uB2E4. \uB300\uD45C\uC801\uC778
      \uC2DD\uBB3C\uB85C \uB178\uAC01\uB098\uBB34, \uBAA9\uB828, \uC138\uBCF5\uC218\uCD08,
      \uC0B0\uB9C8\uB298 \uB4F1\uC774 \uC2DD\uC7AC\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 9014567828303872
    m_Localized: "\uD3F4\uB9AC\uB124\uC774\uD130 \uAC00\uB4E0\uC740 \uC2DD\uBB3C\uC774
      \uAF43\uC744 \uD53C\uC6B0\uACE0 \uC5F4\uB9E4\uB97C \uB9FA\uC744 \uC218 \uC788\uB3C4\uB85D
      \uAF43\uAC00\uB8E8\uC758 \uC774\uB3D9\uC744 \uB3C4\uC640\uC8FC\uB294 \uACE4\uCDA9\uC744
      \uBE44\uB86F\uD55C \uB3D9\uBB3C\uB4E4\uC744 \uC704\uD574 \uC870\uC131\uD55C
      \uC815\uC6D0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
